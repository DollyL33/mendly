# Copy this file to .env.local and fill in the values. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Sandbox Personal account that plays Marco, the handyman (receives payouts)
MARCO_PAYPAL_EMAIL=

# Sandbox Personal account that plays Linda, shown in the demo banner
DEMO_LINDA_EMAIL=
DEMO_LINDA_PASSWORD=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
AI_CALLS_PER_VISITOR=20

# Where the database and photos live (./data locally, /var/data on Render)
DATA_DIR=./data
